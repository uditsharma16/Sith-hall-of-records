{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sith-hall-of-records",
  "main": "src/worker.js",
  "compatibility_date": "2026-09-17",
  "assets": {
    "directory": "./src/client",
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": true,
    "html_handling": "none"
  },
  "observability": {
    "enabled": true
  }
}
